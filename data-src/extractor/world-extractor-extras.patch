+    /// Affine transform UE local -> UE world (cm): world = L . local + T, L row-major 3x3 (rotation and scale).
+    public sealed record Xf(double[] L, double[] T)
+    {
+        static readonly Dictionary<UObject, Xf> cache = new(ReferenceEqualityComparer.Instance);
+        /// Components only attach within their own package; the cache is cleared per package to free memory.
+        public static void ClearCache() => cache.Clear();
+
+        /// The component's relative transform (FRotationMatrix rows = rotated axes; scale applied first).
+        public static Xf Relative(UObject c)
+        {
+            var l = c.GetOrDefault<FVector>("RelativeLocation");
+            var r = c.GetOrDefault<FRotator>("RelativeRotation");
+            var s = c.GetOrDefault<FVector>("RelativeScale3D", new FVector(1, 1, 1));
+            var rot = RotMatrix(r);
+            double[] sc = [s.X, s.Y, s.Z];
+            var m = new double[9];
+            for (int row = 0; row < 3; row++)
+                for (int col = 0; col < 3; col++)
+                    m[row * 3 + col] = rot[col * 3 + row] * sc[col];
+            return new Xf(m, [l.X, l.Y, l.Z]);
+        }
+
+        /// World transform: the relative transforms up the AttachParent chain.
+        public static Xf World(UObject c, int depth = 0)
+        {
+            if (cache.TryGetValue(c, out var hit)) return hit;
+            if (depth > 32) throw new Exception("attachment chain too deep");
+            var rel = Relative(c);
+            var parentRef = c.GetOrDefault<FPackageIndex>("AttachParent");
+            var parent = parentRef is null || parentRef.IsNull ? null : parentRef.Load();
+            var world = parent is null ? rel : World(parent, depth + 1).Then(rel);
+            cache[c] = world;
+            return world;
+        }
+
+        /// this . child (apply child first).
+        public Xf Then(Xf child)
+        {
+            var m = new double[9];
+            for (int r = 0; r < 3; r++)
+                for (int c = 0; c < 3; c++)
+                    m[r * 3 + c] = L[r * 3] * child.L[c] + L[r * 3 + 1] * child.L[3 + c] + L[r * 3 + 2] * child.L[6 + c];
+            var t = Apply(child.T[0], child.T[1], child.T[2]);
+            return new Xf(m, t);
+        }
+
+        public double[] Apply(double x, double y, double z) =>
+            [L[0] * x + L[1] * y + L[2] * z + T[0], L[3] * x + L[4] * y + L[5] * z + T[1], L[6] * x + L[7] * y + L[8] * z + T[2]];
+
+        public Box3 Bounds(float[] min, float[] max)
+        {
+            var b = new Box3(double.MaxValue, double.MaxValue, double.MaxValue, double.MinValue, double.MinValue, double.MinValue);
+            foreach (var x in new[] { min[0], max[0] })
+                foreach (var y in new[] { min[1], max[1] })
+                    foreach (var z in new[] { min[2], max[2] })
+                    {
+                        var p = Apply(x, y, z);
+                        b = b.Union(new Box3(p[0], p[1], p[2], p[0], p[1], p[2]));
+                    }
+            return b;
+        }
+
+        static double[] RotMatrix(FRotator r)
+        {
+            double p = r.Pitch * Math.PI / 180, y = r.Yaw * Math.PI / 180, ro = r.Roll * Math.PI / 180;
+            double sp = Math.Sin(p), cp = Math.Cos(p), sy = Math.Sin(y), cy = Math.Cos(y), sr = Math.Sin(ro), cr = Math.Cos(ro);
+            return [cp * cy, cp * sy, sp, sr * sp * cy - cr * sy, sr * sp * sy + cr * cy, -sr * cp, -(cr * sp * cy + sr * sy), cy * sr - cr * sp * sy, cr * cp];
+        }
+    }
