+            int AddPrimitive(float[] gltfPositions, uint[] indices)
+            {
+                Align(bin);
+                long posOffset = bin.Length;
+                foreach (var f in gltfPositions) bin.Write(BitConverter.GetBytes(f));
+                long idxOffset = bin.Length;
+                foreach (var i in indices) bin.Write(BitConverter.GetBytes(i));
+                float[] min = [float.MaxValue, float.MaxValue, float.MaxValue], max = [float.MinValue, float.MinValue, float.MinValue];
+                for (int i = 0; i < gltfPositions.Length; i++) { min[i % 3] = Math.Min(min[i % 3], gltfPositions[i]); max[i % 3] = Math.Max(max[i % 3], gltfPositions[i]); }
+                bufferViews.Add(new Dictionary<string, object> { ["buffer"] = 0, ["byteOffset"] = posOffset, ["byteLength"] = gltfPositions.Length * 4, ["target"] = 34962 });
+                accessors.Add(new Dictionary<string, object> { ["bufferView"] = bufferViews.Count - 1, ["componentType"] = 5126, ["count"] = gltfPositions.Length / 3, ["type"] = "VEC3", ["min"] = min, ["max"] = max });
+                int posAcc = accessors.Count - 1;
+                bufferViews.Add(new Dictionary<string, object> { ["buffer"] = 0, ["byteOffset"] = idxOffset, ["byteLength"] = indices.Length * 4, ["target"] = 34963 });
+                accessors.Add(new Dictionary<string, object> { ["bufferView"] = bufferViews.Count - 1, ["componentType"] = 5125, ["count"] = indices.Length, ["type"] = "SCALAR" });
+                return posAcc;
+            }
+
+            foreach (var p in placed)
+            {
+                if (p.Baked is { } baked)
+                {
+                    var bpos = new float[baked.Length];
+                    for (int i = 0; i < bpos.Length; i += 3) { bpos[i] = baked[i] / 100f; bpos[i + 1] = baked[i + 2] / 100f; bpos[i + 2] = baked[i + 1] / 100f; }
+                    int bacc = AddPrimitive(bpos, p.Mesh.Indices);
+                    meshes.Add(new Dictionary<string, object> { ["name"] = p.Mesh.Name, ["primitives"] = new[] { new Dictionary<string, object> { ["attributes"] = new Dictionary<string, int> { ["POSITION"] = bacc }, ["indices"] = bacc + 1 } } });
+                    nodes.Add(new Dictionary<string, object> { ["name"] = p.Actor, ["mesh"] = meshes.Count - 1, ["extras"] = new { actor = p.Actor, mesh = p.MeshPath, spline = true } });
+                    triangles += p.Mesh.Indices.Length / 3;
+                    continue;
+                }
+                if (!meshIndex.TryGetValue(p.MeshPath, out var mi))
+                {
+                    var m = p.Mesh;
+                    var pos = new float[m.Positions.Length];
+                    for (int i = 0; i < pos.Length; i += 3) { pos[i] = m.Positions[i] / 100f; pos[i + 1] = m.Positions[i + 2] / 100f; pos[i + 2] = m.Positions[i + 1] / 100f; }
+                    // UE's front faces are clockwise in its left-handed frame; the axis swap mirrors that into
+                    // glTF's counter-clockwise, so the index order stays as it is.
+                    var idx = m.Indices;
+                    int acc = AddPrimitive(pos, idx);
+                    meshes.Add(new Dictionary<string, object> { ["name"] = m.Name, ["primitives"] = new[] { new Dictionary<string, object> { ["attributes"] = new Dictionary<string, int> { ["POSITION"] = acc }, ["indices"] = acc + 1 } } });
+                    meshIndex[p.MeshPath] = mi = meshes.Count - 1;
+                }
+                triangles += p.Mesh.Indices.Length / 3;
+                nodes.Add(new Dictionary<string, object> { ["name"] = p.Actor, ["mesh"] = mi, ["matrix"] = GltfMatrix(p.Transform), ["extras"] = new { actor = p.Actor, mesh = p.MeshPath } });
+            }
+
+            if (terrain is { } t)
+            {
+                var pos = new List<float>(); var idx = new List<uint>(); var vid = new int[t.W * t.H];
+                for (int k = 0; k < vid.Length; k++)
+                {
+                    vid[k] = -1;
+                    if (float.IsNaN(t.Z[k])) continue;
+                    int i = k % t.W, j = k / t.W;
+                    double x = t.Ox + (t.I0 + i) * t.Quad, y = t.Oy + (t.J0 + j) * t.Quad;
+                    vid[k] = pos.Count / 3;
+                    pos.Add((float)(x / 100)); pos.Add(t.Z[k] / 100f); pos.Add((float)(y / 100));
+                }
+                for (int j = 0; j + 1 < t.H; j++)
+                    for (int i = 0; i + 1 < t.W; i++)
+                    {
+                        int a = j * t.W + i, b = a + 1, c = a + t.W, d = c + 1;
+                        // a quad is a hole if its first vertex is (UE's convention)
+                        if (t.Hole[a] || vid[a] < 0 || vid[b] < 0 || vid[c] < 0 || vid[d] < 0) continue;
+                        // counter-clockwise seen from above (glTF +Y): normals point up
+                        idx.AddRange([(uint)vid[a], (uint)vid[d], (uint)vid[b], (uint)vid[a], (uint)vid[c], (uint)vid[d]]);
+                    }
+                if (idx.Count > 0)
+                {
+                    int acc = AddPrimitive(pos.ToArray(), idx.ToArray());
+                    meshes.Add(new Dictionary<string, object> { ["name"] = "landscape", ["primitives"] = new[] { new Dictionary<string, object> { ["attributes"] = new Dictionary<string, int> { ["POSITION"] = acc }, ["indices"] = acc + 1 } } });
+                    nodes.Add(new Dictionary<string, object> { ["name"] = "landscape", ["mesh"] = meshes.Count - 1 });
