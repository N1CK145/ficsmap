+            var hTex = c.GetOrDefault<FPackageIndex>("HeightmapTexture")?.Load<UTexture2D>();
+            if (hTex is null) return;
+            using var hb = (hTex.Decode() ?? throw new Exception($"heightmap of {c.Name}")).ToSkBitmap();
+            var hs = c.GetOrDefault<FVector4>("HeightmapScaleBias");
+            int hox = (int)Math.Round(hs.Z * hb.Width), hoy = (int)Math.Round(hs.W * hb.Height);
+            var holes = new HashSet<(int, int)>();
+            foreach (var alloc in c.GetOrDefault<FStructFallback[]>("WeightmapLayerAllocations", []))
+            {
+                if (alloc.GetOrDefault<FPackageIndex>("LayerInfo")?.Name != "LandscapeVisibilityLayerInfo") continue;
+                var tex = c.GetOrDefault<FPackageIndex[]>("WeightmapTextures", [])[alloc.GetOrDefault<byte>("WeightmapTextureIndex")].Load<UTexture2D>();
+                if (tex is null) continue;
+                using var wb = (tex.Decode() ?? throw new Exception($"weightmap of {c.Name}")).ToSkBitmap();
+                var ws = c.GetOrDefault<FVector4>("WeightmapScaleBias");
+                int wox = (int)Math.Round(ws.Z * wb.Width), woy = (int)Math.Round(ws.W * wb.Height);
+                int ch = alloc.GetOrDefault<byte>("WeightmapTextureChannel");
+                for (int j = 0; j <= q; j++)
+                    for (int i = 0; i <= q; i++)
+                    {
+                        var px = wb.GetPixel(Math.Min(wox + i, wb.Width - 1), Math.Min(woy + j, wb.Height - 1));
+                        if ((ch switch { 0 => px.Red, 1 => px.Green, 2 => px.Blue, _ => px.Alpha }) > 127) holes.Add((i, j));
+                    }
+            }
+            for (int j = 0; j <= q; j++)
+                for (int i = 0; i <= q; i++)
+                {
+                    var px = hb.GetPixel(Math.Min(hox + i, hb.Width - 1), Math.Min(hoy + j, hb.Height - 1));
+                    int h = px.Red << 8 | px.Green;
+                    // LANDSCAPE_ZSCALE = 1/128; height 32768 = 0
+                    float z = (float)(oz + (h - 32768) / 128.0 * zScale);
+                    sink(bx + i, by + j, z, holes.Contains((i, j)));
+                }
+        }
+
+        public (double Ox, double Oy, double Quad, int I0, int J0, int W, int H, float[] Z, bool[] Hole)? Grid(Box3 b)
+        {
+            if (!hasTransform) return null;
+            int i0 = (int)Math.Floor((b.MinX - ox) / quad), i1 = (int)Math.Ceiling((b.MaxX - ox) / quad);
+            int j0 = (int)Math.Floor((b.MinY - oy) / quad), j1 = (int)Math.Ceiling((b.MaxY - oy) / quad);
+            foreach (var c in pending.ToList())
+            {
+                int bx = c.GetOrDefault<int>("SectionBaseX"), by = c.GetOrDefault<int>("SectionBaseY"), q = c.GetOrDefault<int>("ComponentSizeQuads", 127);
+                if (bx > i1 || bx + q < i0 || by > j1 || by + q < j0) continue;
+                Decode(c);
+                pending.Remove(c);
+            }
+            int w = i1 - i0 + 1, h = j1 - j0 + 1;
+            var z = new float[w * h]; var hole = new bool[w * h];
+            for (int j = 0; j < h; j++)
+                for (int i = 0; i < w; i++)
+                {
+                    if (verts.TryGetValue((i0 + i, j0 + j), out var v)) { z[j * w + i] = v.Z; hole[j * w + i] = v.Hole; }
+                    else { z[j * w + i] = float.NaN; hole[j * w + i] = true; }
+                }
+            return (ox, oy, quad, i0, j0, w, h, z, hole);
+        }
+    }
+
+    /// Minimal glTF 2.0 binary writer: positions + indices, one mesh per static mesh, one node per instance.
+    static class Glb
+    {
+        public static long Write(string path, List<Placed> placed, (double Ox, double Oy, double Quad, int I0, int J0, int W, int H, float[] Z, bool[] Hole)? terrain)
+        {
+            var bin = new MemoryStream();
+            var bufferViews = new List<object>(); var accessors = new List<object>(); var meshes = new List<object>(); var nodes = new List<object>();
+            var meshIndex = new Dictionary<string, int>();
+            long triangles = 0;
+
+            int AddPrimitive(float[] gltfPositions, uint[] indices)
+            {
+                Align(bin);
+                long posOffset = bin.Length;
+                foreach (var f in gltfPositions) bin.Write(BitConverter.GetBytes(f));
+                long idxOffset = bin.Length;
+                foreach (var i in indices) bin.Write(BitConverter.GetBytes(i));
+                float[] min = [float.MaxValue, float.MaxValue, float.MaxValue], max = [float.MinValue, float.MinValue, float.MinValue];
+                for (int i = 0; i < gltfPositions.Length; i++) { min[i % 3] = Math.Min(min[i % 3], gltfPositions[i]); max[i % 3] = Math.Max(max[i % 3], gltfPositions[i]); }
+                bufferViews.Add(new Dictionary<string, object> { ["buffer"] = 0, ["byteOffset"] = posOffset, ["byteLength"] = gltfPositions.Length * 4, ["target"] = 34962 });
+                accessors.Add(new Dictionary<string, object> { ["bufferView"] = bufferViews.Count - 1, ["componentType"] = 5126, ["count"] = gltfPositions.Length / 3, ["type"] = "VEC3", ["min"] = min, ["max"] = max });
+                int posAcc = accessors.Count - 1;
+                bufferViews.Add(new Dictionary<string, object> { ["buffer"] = 0, ["byteOffset"] = idxOffset, ["byteLength"] = indices.Length * 4, ["target"] = 34963 });
+                accessors.Add(new Dictionary<string, object> { ["bufferView"] = bufferViews.Count - 1, ["componentType"] = 5125, ["count"] = indices.Length, ["type"] = "SCALAR" });
+                return posAcc;
+            }
+
+            foreach (var p in placed)
+            {
+                if (p.Baked is { } baked)
+                {
+                    var bpos = new float[baked.Length];
+                    for (int i = 0; i < bpos.Length; i += 3) { bpos[i] = baked[i] / 100f; bpos[i + 1] = baked[i + 2] / 100f; bpos[i + 2] = baked[i + 1] / 100f; }
+                    int bacc = AddPrimitive(bpos, p.Mesh.Indices);
+                    meshes.Add(new Dictionary<string, object> { ["name"] = p.Mesh.Name, ["primitives"] = new[] { new Dictionary<string, object> { ["attributes"] = new Dictionary<string, int> { ["POSITION"] = bacc }, ["indices"] = bacc + 1 } } });
+                    nodes.Add(new Dictionary<string, object> { ["name"] = p.Actor, ["mesh"] = meshes.Count - 1, ["extras"] = new { actor = p.Actor, mesh = p.MeshPath, spline = true } });
+                    triangles += p.Mesh.Indices.Length / 3;
+                    continue;
+                }
+                if (!meshIndex.TryGetValue(p.MeshPath, out var mi))
+                {
+                    var m = p.Mesh;
+                    var pos = new float[m.Positions.Length];
+                    for (int i = 0; i < pos.Length; i += 3) { pos[i] = m.Positions[i] / 100f; pos[i + 1] = m.Positions[i + 2] / 100f; pos[i + 2] = m.Positions[i + 1] / 100f; }
+                    // UE's front faces are clockwise in its left-handed frame; the axis swap mirrors that into
+                    // glTF's counter-clockwise, so the index order stays as it is.
+                    var idx = m.Indices;
+                    int acc = AddPrimitive(pos, idx);
+                    meshes.Add(new Dictionary<string, object> { ["name"] = m.Name, ["primitives"] = new[] { new Dictionary<string, object> { ["attributes"] = new Dictionary<string, int> { ["POSITION"] = acc }, ["indices"] = acc + 1 } } });
+                    meshIndex[p.MeshPath] = mi = meshes.Count - 1;
+                }
+                triangles += p.Mesh.Indices.Length / 3;
+                nodes.Add(new Dictionary<string, object> { ["name"] = p.Actor, ["mesh"] = mi, ["matrix"] = GltfMatrix(p.Transform), ["extras"] = new { actor = p.Actor, mesh = p.MeshPath } });
+            }
+
+            if (terrain is { } t)
+            {
+                var pos = new List<float>(); var idx = new List<uint>(); var vid = new int[t.W * t.H];
+                for (int k = 0; k < vid.Length; k++)
+                {
+                    vid[k] = -1;
+                    if (float.IsNaN(t.Z[k])) continue;
+                    int i = k % t.W, j = k / t.W;
+                    double x = t.Ox + (t.I0 + i) * t.Quad, y = t.Oy + (t.J0 + j) * t.Quad;
+                    vid[k] = pos.Count / 3;
+                    pos.Add((float)(x / 100)); pos.Add(t.Z[k] / 100f); pos.Add((float)(y / 100));
+                }
+                for (int j = 0; j + 1 < t.H; j++)
+                    for (int i = 0; i + 1 < t.W; i++)
+                    {
+                        int a = j * t.W + i, b = a + 1, c = a + t.W, d = c + 1;
+                        // a quad is a hole if its first vertex is (UE's convention)
+                        if (t.Hole[a] || vid[a] < 0 || vid[b] < 0 || vid[c] < 0 || vid[d] < 0) continue;
+                        // counter-clockwise seen from above (glTF +Y): normals point up
+                        idx.AddRange([(uint)vid[a], (uint)vid[d], (uint)vid[b], (uint)vid[a], (uint)vid[c], (uint)vid[d]]);
+                    }
+                if (idx.Count > 0)
+                {
+                    int acc = AddPrimitive(pos.ToArray(), idx.ToArray());
+                    meshes.Add(new Dictionary<string, object> { ["name"] = "landscape", ["primitives"] = new[] { new Dictionary<string, object> { ["attributes"] = new Dictionary<string, int> { ["POSITION"] = acc }, ["indices"] = acc + 1 } } });
+                    nodes.Add(new Dictionary<string, object> { ["name"] = "landscape", ["mesh"] = meshes.Count - 1 });
+                    triangles += idx.Count / 3;
+                }
+            }
+
+            Align(bin);
+            var gltf = new Dictionary<string, object>
+            {
+                ["asset"] = new { version = "2.0", generator = "ficsmap world-extractor (CaveGeometry)" },
+                ["scene"] = 0,
+                ["scenes"] = new[] { new { nodes = Enumerable.Range(0, nodes.Count).ToArray() } },
+                ["nodes"] = nodes, ["meshes"] = meshes, ["accessors"] = accessors, ["bufferViews"] = bufferViews,
+                ["buffers"] = new[] { new { byteLength = bin.Length } },
+            };
+            var json = System.Text.Encoding.UTF8.GetBytes(JsonSerializer.Serialize(gltf));
+            int jsonPad = (4 - json.Length % 4) % 4;
+            using var f = File.Create(path);
+            using var w = new BinaryWriter(f);
+            w.Write(0x46546C67u); w.Write(2u); w.Write((uint)(12 + 8 + json.Length + jsonPad + 8 + bin.Length));
+            w.Write((uint)(json.Length + jsonPad)); w.Write(0x4E4F534Au); w.Write(json); for (int i = 0; i < jsonPad; i++) w.Write((byte)0x20);
+            w.Write((uint)bin.Length); w.Write(0x004E4942u); w.Write(bin.ToArray());
+            return triangles;
+        }
+
+        static void Align(MemoryStream s) { while (s.Length % 4 != 0) s.WriteByte(0); }
+
+        // glTF column-major 4x4 of P . M . P^-1: P swaps UE Y and Z and turns cm into m. Mesh vertices are
+        // already in glTF axes and metres, so the linear part is the swapped L and the translation is P . T.
+        static double[] GltfMatrix(Xf t)
+        {
+            int[] perm = [0, 2, 1]; // glTF axis k = UE axis perm[k]
+            var m = new double[16];
+            for (int c = 0; c < 3; c++)
+                for (int r = 0; r < 3; r++)
+                    m[c * 4 + r] = t.L[perm[r] * 3 + perm[c]];
+            m[12] = t.T[0] / 100; m[13] = t.T[2] / 100; m[14] = t.T[1] / 100; m[15] = 1;
+            return m;
+        }
+    }
+}
