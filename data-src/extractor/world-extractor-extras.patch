+        "SkySphere", "BP_Sky", "BP_Planet", "BP_Manta", "Char_"];
+    /// Anything larger than this (sky sphere, planets) is scenery, not cave.
+    internal const double MaxExtent = 500000;
+    internal static bool Skipped(string owner) => SkippedOwners.Any(p => owner.StartsWith(p, StringComparison.Ordinal));
+    internal static bool SkippedMesh(string mesh) => mesh.Contains("Water", StringComparison.OrdinalIgnoreCase) || mesh.Contains("Fog", StringComparison.OrdinalIgnoreCase)
