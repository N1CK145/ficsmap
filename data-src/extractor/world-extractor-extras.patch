+    /// Minimal glTF 2.0 binary writer: positions + indices, one mesh per static mesh, one node per instance.
+    static class Glb
+    {
+        public static long Write(string path, List<Placed> placed, (double Ox, double Oy, double Quad, int I0, int J0, int W, int H, float[] Z, bool[] Hole)? terrain)
+        {
+            var bin = new MemoryStream();
+            var bufferViews = new List<object>(); var accessors = new List<object>(); var meshes = new List<object>(); var nodes = new List<object>();
+            var meshIndex = new Dictionary<string, int>();
+            long triangles = 0;
