+// ---- descriptor icons ----
+
+// --icons-out <dir>: the icon of every descriptor in the game's Docs (items, resources, equipment, buildings, vehicles, ...),
+// for the in-app machine and vehicle wiki. The class list and each class's icon texture come from
+// <install>/CommunityResources/Docs/en-US.json: mSmallIcon, else mPersistentBigIcon (the Docs resolve inherited values; in
+// 1.2.5.0 both fields name the same 256 or 512 px texture for every class). The textures are read from the paks and written
+// as <dir>/<size>/<ClassName>.webp for each of Sizes (square, transparent background), plus <dir>/index.json.
+static class DescriptorIcons
+{
+    public static readonly int[] Sizes = [64, 256];
+    const int WebpQuality = 90;
+    const string DocsFile = "CommunityResources/Docs/en-US.json";
+    static readonly Regex TextureValue = new(@"^(?:\w+ )?/Game/(\S+)$");
+
+    public record Icon(
+        [property: JsonPropertyName("nativeClass")] string NativeClass,
+        [property: JsonPropertyName("texture")] string Texture);
+
+    public record Index(
+        [property: JsonPropertyName("gameVersion")] string GameVersion,
+        [property: JsonPropertyName("format")] string Format,
+        [property: JsonPropertyName("sizes")] int[] Sizes,
+        [property: JsonPropertyName("icons")] SortedDictionary<string, Icon> Icons,
+        [property: JsonPropertyName("missing")] SortedDictionary<string, string> Missing);
+
+    public static Index Write(IFileProvider provider, string installDir, string gameVersion, string outDir)
+    {
+        string docsPath = Path.Combine(installDir, DocsFile);
+        if (!File.Exists(docsPath)) throw new Exception($"--icons-out needs the game's Docs: {docsPath} not found.");
+        // UTF-16 LE with a byte order mark: ReadAllText detects it (JsonDocument alone reads only UTF-8).
+        using var docs = JsonDocument.Parse(File.ReadAllText(docsPath));
+        var wanted = new SortedDictionary<string, Icon>(StringComparer.Ordinal);
+        var missing = new SortedDictionary<string, string>(StringComparer.Ordinal);
+        foreach (var group in docs.RootElement.EnumerateArray())
+        {
+            string native = Regex.Match(group.GetProperty("NativeClass").GetString() ?? "", @"\.(\w+)'?$").Groups[1].Value;
+            foreach (var c in group.GetProperty("Classes").EnumerateArray())
+            {
+                string? small = Field(c, "mSmallIcon"), big = Field(c, "mPersistentBigIcon");
+                if (small is null && big is null) continue;
+                string cls = Field(c, "ClassName") ?? throw new Exception("Docs class without a ClassName");
+                string? texture = TexturePath(small) ?? TexturePath(big);
+                if (texture is null) missing[cls] = $"no icon in the Docs ({small ?? big})";
+                else wanted[cls] = new Icon(native, texture);
+            }
+        }
+        if (wanted.Count == 0) throw new Exception($"No descriptor icons found in {docsPath}; the Docs format probably changed.");
+
+        foreach (int size in Sizes)
+        {
+            string dir = Path.Combine(outDir, size.ToString());
+            if (Directory.Exists(dir)) Directory.Delete(dir, true);
+            Directory.CreateDirectory(dir);
+        }
+        // Several classes share a texture (FICSMAS cartridges, jump pads): decode each texture once.
+        var written = new SortedDictionary<string, Icon>(StringComparer.Ordinal);
+        foreach (var byTexture in wanted.GroupBy(w => w.Value.Texture))
+        {
+            byte[][] encoded;
+            try
+            {
+                string objectPath = "FactoryGame/Content/" + byTexture.Key;
+                using var texture = IconImage.Decode(provider.LoadPackageObject<UTexture2D>(objectPath));
+                if (texture.Width < Sizes.Max() || texture.Height < Sizes.Max())
+                    Console.Error.WriteLine($"WARN: icon texture {byTexture.Key} is only {texture.Width}x{texture.Height} px");
+                using var square = texture.Width == texture.Height ? null : IconImage.Square(texture);
+                encoded = Sizes.Select(size => IconImage.Encode(square ?? texture, size, SKEncodedImageFormat.Webp, WebpQuality)).ToArray();
+            }
+            catch (Exception e)
+            {
+                foreach (var (cls, _) in byTexture) missing[cls] = $"texture {byTexture.Key} failed: {e.Message}";
+                Console.Error.WriteLine($"WARN: icon texture {byTexture.Key} failed: {e.Message}");
+                continue;
+            }
+            foreach (var (cls, icon) in byTexture)
+            {
+                for (int i = 0; i < Sizes.Length; i++)
+                    File.WriteAllBytes(Path.Combine(outDir, Sizes[i].ToString(), $"{cls}.webp"), encoded[i]);
+                written[cls] = icon;
