+    /// USplineMeshComponent deformation (forward axis X, as the cave floor blueprint uses): each vertex is moved
+    /// to the cubic Hermite spline at its position along the mesh's X extent, its Y/Z become offsets in the
+    /// spline's cross-section frame (up = Z), with roll and scale interpolated linearly.
+    internal static class SplineMesh
+    {
+        public static float[]? Deform(UObject c, MeshData mesh, Xf world)
+        {
+            var p = c.GetOrDefault<FStructFallback>("SplineParams");
+            if (p is null) return null;
+            var tmpl = c.Template?.Load();
+            var forward = c.GetOrDefault("ForwardAxis", tmpl?.GetOrDefault<FName>("ForwardAxis") ?? default).ToString();
+            if (forward is not ("" or "None" or "ESplineMeshAxis::X")) { Console.Error.WriteLine($"WARN: spline mesh {c.Name} forward axis {forward} not supported"); return null; }
+            var p0 = V(p.GetOrDefault<FVector>("StartPos")); var t0 = V(p.GetOrDefault<FVector>("StartTangent"));
+            var p1 = V(p.GetOrDefault<FVector>("EndPos")); var t1 = V(p.GetOrDefault<FVector>("EndTangent"));
+            var s0 = p.GetOrDefault("StartScale", new FVector2D(1, 1)); var s1 = p.GetOrDefault("EndScale", new FVector2D(1, 1));
+            var o0 = p.GetOrDefault("StartOffset", new FVector2D(0, 0)); var o1 = p.GetOrDefault("EndOffset", new FVector2D(0, 0));
+            double r0 = p.GetOrDefault<float>("StartRoll"), r1 = p.GetOrDefault<float>("EndRoll");
+            double[] upDir = [0, 0, 1];
+            double minX = mesh.Min[0], len = mesh.Max[0] - mesh.Min[0];
+            if (len <= 0) return null;
+            var outPos = new float[mesh.Positions.Length];
+            for (int i = 0; i < mesh.Positions.Length; i += 3)
+            {
+                double a = (mesh.Positions[i] - minX) / len;
+                double a2 = a * a, a3 = a2 * a;
+                double h00 = 2 * a3 - 3 * a2 + 1, h10 = a3 - 2 * a2 + a, h01 = -2 * a3 + 3 * a2, h11 = a3 - a2;
+                double d00 = 6 * a2 - 6 * a, d10 = 3 * a2 - 4 * a + 1, d01 = -6 * a2 + 6 * a, d11 = 3 * a2 - 2 * a;
+                var pos = new double[3]; var dir = new double[3];
+                for (int k = 0; k < 3; k++)
+                {
+                    pos[k] = h00 * p0[k] + h10 * t0[k] + h01 * p1[k] + h11 * t1[k];
+                    dir[k] = d00 * p0[k] + d10 * t0[k] + d01 * p1[k] + d11 * t1[k];
+                }
+                Normalize(dir);
+                var bx = Cross(upDir, dir); Normalize(bx);
+                var by = Cross(dir, bx); Normalize(by);
+                double roll = r0 + (r1 - r0) * a, ca = Math.Cos(roll), sa = Math.Sin(roll);
+                double sx = s0.X + (s1.X - s0.X) * a, sy = s0.Y + (s1.Y - s0.Y) * a;
+                double ox = o0.X + (o1.X - o0.X) * a, oy = o0.Y + (o1.Y - o0.Y) * a;
+                double ly = mesh.Positions[i + 1], lz = mesh.Positions[i + 2];
+                for (int k = 0; k < 3; k++)
+                {
+                    double xv = ca * bx[k] - sa * by[k], yv = ca * by[k] + sa * bx[k];
+                    pos[k] += xv * (ox + ly * sx) + yv * (oy + lz * sy);
+                }
+                var w = world.Apply(pos[0], pos[1], pos[2]);
+                outPos[i] = (float)w[0]; outPos[i + 1] = (float)w[1]; outPos[i + 2] = (float)w[2];
+            }
+            return outPos;
+        }
+
+        /// Box around both spline ends, grown by the mesh's largest extent times the largest scale.
+        public static Box3? RoughBounds(UObject c, Xf world, MeshRef mesh)
+        {
+            var p = c.GetOrDefault<FStructFallback>("SplineParams");
+            if (p is null) return null;
+            var a = p.GetOrDefault<FVector>("StartPos"); var b = p.GetOrDefault<FVector>("EndPos");
+            var s0 = p.GetOrDefault("StartScale", new FVector2D(1, 1)); var s1 = p.GetOrDefault("EndScale", new FVector2D(1, 1));
+            double grow = Math.Max(Math.Max(Math.Abs(mesh.Min[1]), Math.Abs(mesh.Max[1])), Math.Max(Math.Abs(mesh.Min[2]), Math.Abs(mesh.Max[2])))
+                * Math.Max(Math.Max(s0.X, s0.Y), Math.Max(s1.X, s1.Y)) + (b - a).Size() * 0.5;
+            var pa = world.Apply(a.X, a.Y, a.Z); var pb = world.Apply(b.X, b.Y, b.Z);
+            double sc = Math.Sqrt(world.L[0] * world.L[0] + world.L[3] * world.L[3] + world.L[6] * world.L[6]);
+            grow *= Math.Max(sc, 1e-6);
+            return new Box3(Math.Min(pa[0], pb[0]) - grow, Math.Min(pa[1], pb[1]) - grow, Math.Min(pa[2], pb[2]) - grow,
+                Math.Max(pa[0], pb[0]) + grow, Math.Max(pa[1], pb[1]) + grow, Math.Max(pa[2], pb[2]) + grow);
+        }
+
+        static double[] V(FVector v) => [v.X, v.Y, v.Z];
+        static double[] Cross(double[] a, double[] b) => [a[1] * b[2] - a[2] * b[1], a[2] * b[0] - a[0] * b[2], a[0] * b[1] - a[1] * b[0]];
+        static void Normalize(double[] v) { var n = Math.Sqrt(v[0] * v[0] + v[1] * v[1] + v[2] * v[2]); if (n > 0) for (int k = 0; k < 3; k++) v[k] /= n; }
+    }
