+static void CollectExtra(UObject actor, SortedDictionary<string, DropPodExtra> pods, List<ShrineExtra> shrines)
+{
+    if (actor.ExportType == "BP_MercerShrine_C")
+    {
+        // Shrines are attached to the Mercer Sphere's mesh, so their own RelativeLocation is only an offset.
+        var root = actor.Get<FPackageIndex>("RootComponent").Load()!;
+        var parent = root.GetOrDefault<FPackageIndex>("AttachParent");
+        string? sphere = parent is { IsNull: false } ? parent.ResolvedObject?.Outer?.Name.Text : null;
+        var parentLoc = parent is { IsNull: false } ? parent.Load()?.GetOrDefault<FVector>("RelativeLocation") ?? FVector.ZeroVector : FVector.ZeroVector;
+        var offset = root.GetOrDefault<FVector>("RelativeLocation");
+        shrines.Add(new ShrineExtra(actor.Name, sphere,
+            [MathF.Round(parentLoc.X + offset.X, 1), MathF.Round(parentLoc.Y + offset.Y, 1), MathF.Round(parentLoc.Z + offset.Z, 1)]));
+        return;
+    }
+    // mUnlockCost is only serialised when it differs from the default; pods without it get costType null.
+    var cost = actor.GetOrDefault<FStructFallback>("mUnlockCost");
+    var itemCost = cost?.GetOrDefault<FStructFallback>("ItemCost");
+    var itemClass = itemCost?.GetOrDefault<FPackageIndex>("ItemClass");
+    pods[actor.Name] = new DropPodExtra(
+        cost?.GetOrDefault<FName>("CostType").ToString().Split("::").Last(),
+        itemClass is { IsNull: false } ? itemClass.Name : null,
+        itemCost?.GetOrDefault<int>("Amount") ?? 0,
+        cost?.GetOrDefault<float>("PowerConsumption") ?? 0);
+}
