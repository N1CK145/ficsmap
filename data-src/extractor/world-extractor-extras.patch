+// ---- caves ----
+
+// The game's cave volumes: FGAmbientVolume actors whose ambient-settings class has "Cave" in its name
+// (AS_CaveLarge_C, AmbientSettings_Caves_*_C, CaveWaterfall_Rework_Thin_C, ...; not AmbientSettings_CaveWind_C)
+// and FGAtmosphereVolume actors with "cave" in the actor name (Atmosphere_SwampCave, ...): the zones in which the
+// game switches to cave sound and fog. Rough hand-placed boxes; they tell where caves are and at what height,
+// not their shape (that comes from CaveGeometry). Each convex collision element of the brush is written as its
+// 2D convex hull in world X/Y plus its world Z range.
+static class CaveData
+{
+    public static Caves Read(IFileProvider provider)
+    {
+        var volumes = new List<CaveVolume>();
+        foreach (var file in provider.Files.Keys
+                     .Where(k => k.StartsWith(PickupContents.CellsDir, StringComparison.OrdinalIgnoreCase) && k.EndsWith(".umap"))
+                     .Prepend("FactoryGame/Content/FactoryGame/Map/GameLevel01/Persistent_Level.umap"))
+        {
+            List<UObject> exports;
+            try { exports = provider.LoadPackage(file).GetExports().ToList(); }
+            catch { continue; }
+            foreach (var e in exports)
+            {
+                if (e.ExportType is not ("FGAmbientVolume" or "FGAtmosphereVolume") || !IsCave(e)) continue;
+                var elements = Elements(e);
+                if (elements.Count > 0) volumes.Add(new CaveVolume(e.Name, Source(e), elements));
+            }
+        }
+        return new Caves(volumes.OrderBy(v => v.Name, StringComparer.Ordinal).ToList());
+    }
+
+    private static bool IsCave(UObject e)
+    {
+        if (e.ExportType == "FGAtmosphereVolume") return e.Name.Contains("cave", StringComparison.OrdinalIgnoreCase);
+        var settings = e.GetOrDefault<FPackageIndex>("mAmbientSettings")?.Name ?? "";
+        return settings.Contains("Cave", StringComparison.Ordinal) && !settings.Contains("CaveWind", StringComparison.Ordinal);
+    }
+
+    private static string Source(UObject e) =>
+        e.ExportType == "FGAmbientVolume" ? $"FGAmbientVolume:{e.GetOrDefault<FPackageIndex>("mAmbientSettings")?.Name}" : e.ExportType;
+
+    private static List<CaveElement> Elements(UObject volume)
+    {
+        var result = new List<CaveElement>();
+        var brush = volume.GetOrDefault<FPackageIndex>("BrushComponent")?.Load();
+        var body = brush?.GetOrDefault<FPackageIndex>("BrushBodySetup")?.Load();
+        if (brush is null || body is null) return result;
+        var loc = brush.GetOrDefault<FVector>("RelativeLocation");
+        var rot = brush.GetOrDefault<FRotator>("RelativeRotation");
+        var scale = brush.GetOrDefault<FVector>("RelativeScale3D", new FVector(1, 1, 1));
+        var agg = body.GetOrDefault<FStructFallback>("AggGeom");
+        if (agg is null) return result;
+        foreach (var elem in agg.GetOrDefault<FStructFallback[]>("ConvexElems", []))
+        {
+            var verts = elem.GetOrDefault<FVector[]>("VertexData", []);
+            bool hasTransform = elem.TryGetValue(out FTransform t, "Transform");
+            if (verts.Length < 3) continue;
+            var world = verts.Select(v =>
+            {
+                var p = hasTransform ? t.TransformPosition(v) : v;
+                return Rotate(new FVector(p.X * scale.X, p.Y * scale.Y, p.Z * scale.Z), rot) + loc;
+            }).ToList();
+            var hull = Hull(world.Select(w => (X: (double)w.X, Y: (double)w.Y)).ToList());
+            if (hull.Count < 3) continue;
+            result.Add(new CaveElement(
+                hull.Select(h => new[] { Math.Round(h.X, 1), Math.Round(h.Y, 1) }).ToList(),
+                Math.Round(world.Min(w => w.Z), 1), Math.Round(world.Max(w => w.Z), 1)));
+        }
+        return result;
+    }
+
+    // FRotationMatrix(rot).TransformVector(v), written out so it does not depend on the library's helpers.
+    private static FVector Rotate(FVector v, FRotator r)
+    {
+        double p = r.Pitch * Math.PI / 180, y = r.Yaw * Math.PI / 180, ro = r.Roll * Math.PI / 180;
+        double sp = Math.Sin(p), cp = Math.Cos(p), sy = Math.Sin(y), cy = Math.Cos(y), sr = Math.Sin(ro), cr = Math.Cos(ro);
+        double[] ax = [cp * cy, cp * sy, sp];
+        double[] ay = [sr * sp * cy - cr * sy, sr * sp * sy + cr * cy, -sr * cp];
+        double[] az = [-(cr * sp * cy + sr * sy), cy * sr - cr * sp * sy, cr * cp];
+        return new FVector(
+            (float)(v.X * ax[0] + v.Y * ay[0] + v.Z * az[0]),
+            (float)(v.X * ax[1] + v.Y * ay[1] + v.Z * az[1]),
+            (float)(v.X * ax[2] + v.Y * ay[2] + v.Z * az[2]));
+    }
+
+    // Andrew's monotone chain, counter-clockwise, no repeated first point.
+    private static List<(double X, double Y)> Hull(List<(double X, double Y)> pts)
+    {
+        pts = pts.Distinct().OrderBy(p => p.X).ThenBy(p => p.Y).ToList();
+        if (pts.Count < 3) return pts;
+        static double Cross((double X, double Y) o, (double X, double Y) a, (double X, double Y) b) =>
+            (a.X - o.X) * (b.Y - o.Y) - (a.Y - o.Y) * (b.X - o.X);
+        var hull = new List<(double X, double Y)>();
+        foreach (var pass in new[] { pts, Enumerable.Reverse(pts).ToList() })
+        {
+            int start = hull.Count;
+            foreach (var p in pass)
+            {
+                while (hull.Count >= start + 2 && Cross(hull[^2], hull[^1], p) <= 0) hull.RemoveAt(hull.Count - 1);
+                hull.Add(p);
+            }
+            hull.RemoveAt(hull.Count - 1);
+        }
+        return hull;
+    }
+
+}
