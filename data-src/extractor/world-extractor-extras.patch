+                double sx = s0.X + (s1.X - s0.X) * a, sy = s0.Y + (s1.Y - s0.Y) * a;
+                double ox = o0.X + (o1.X - o0.X) * a, oy = o0.Y + (o1.Y - o0.Y) * a;
+                double ly = mesh.Positions[i + 1], lz = mesh.Positions[i + 2];
+                for (int k = 0; k < 3; k++)
+                {
+                    double xv = ca * bx[k] - sa * by[k], yv = ca * by[k] + sa * bx[k];
+                    pos[k] += xv * (ox + ly * sx) + yv * (oy + lz * sy);
+                }
+                var w = world.Apply(pos[0], pos[1], pos[2]);
+                outPos[i] = (float)w[0]; outPos[i + 1] = (float)w[1]; outPos[i + 2] = (float)w[2];
+            }
+            return outPos;
+        }
+
+        /// Box around both spline ends, grown by the mesh's largest extent times the largest scale.
+        public static Box3? RoughBounds(UObject c, Xf world, MeshRef mesh)
+        {
+            var p = c.GetOrDefault<FStructFallback>("SplineParams");
+            if (p is null) return null;
+            var a = p.GetOrDefault<FVector>("StartPos"); var b = p.GetOrDefault<FVector>("EndPos");
+            var s0 = p.GetOrDefault("StartScale", new FVector2D(1, 1)); var s1 = p.GetOrDefault("EndScale", new FVector2D(1, 1));
+            double grow = Math.Max(Math.Max(Math.Abs(mesh.Min[1]), Math.Abs(mesh.Max[1])), Math.Max(Math.Abs(mesh.Min[2]), Math.Abs(mesh.Max[2])))
+                * Math.Max(Math.Max(s0.X, s0.Y), Math.Max(s1.X, s1.Y)) + (b - a).Size() * 0.5;
+            var pa = world.Apply(a.X, a.Y, a.Z); var pb = world.Apply(b.X, b.Y, b.Z);
+            double sc = Math.Sqrt(world.L[0] * world.L[0] + world.L[3] * world.L[3] + world.L[6] * world.L[6]);
+            grow *= Math.Max(sc, 1e-6);
+            return new Box3(Math.Min(pa[0], pb[0]) - grow, Math.Min(pa[1], pb[1]) - grow, Math.Min(pa[2], pb[2]) - grow,
+                Math.Max(pa[0], pb[0]) + grow, Math.Max(pa[1], pb[1]) + grow, Math.Max(pa[2], pb[2]) + grow);
+        }
+
+        static double[] V(FVector v) => [v.X, v.Y, v.Z];
+        static double[] Cross(double[] a, double[] b) => [a[1] * b[2] - a[2] * b[1], a[2] * b[0] - a[0] * b[2], a[0] * b[1] - a[1] * b[0]];
+        static void Normalize(double[] v) { var n = Math.Sqrt(v[0] * v[0] + v[1] * v[1] + v[2] * v[2]); if (n > 0) for (int k = 0; k < 3; k++) v[k] /= n; }
+    }
