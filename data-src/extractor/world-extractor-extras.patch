+    /// A static mesh's local bounds (cheap, from the render data) and, on first use, its geometry.
+    public sealed class MeshRef
+    {
+        public required float[] Min, Max;
+        public required FPackageIndex Reference;
+        MeshData? data; bool loaded;
+        public MeshData? Data { get { if (!loaded) { data = MeshData.Load(Reference); loaded = true; } return data; } }
+
+        public static MeshRef? Load(FPackageIndex reference)
+        {
+            try
+            {
+                var sm = reference.Load<CUE4Parse.UE4.Assets.Exports.StaticMesh.UStaticMesh>();
+                var bounds = sm?.RenderData?.Bounds;
+                if (bounds is null) return null;
+                var o = bounds.Origin; var x = bounds.BoxExtent;
+                return new MeshRef { Reference = reference, Min = [o.X - x.X, o.Y - x.Y, o.Z - x.Z], Max = [o.X + x.X, o.Y + x.Y, o.Z + x.Z] };
+            }
+            catch { return null; }
+        }
+    }
+
+    /// One static mesh's render geometry (UE local cm), from the first LOD.
+    public sealed class MeshData
+    {
+        public required string Name;
+        public required float[] Positions; // x, y, z per vertex
+        public required uint[] Indices;
+        public required float[] Min, Max;
+
+        public static MeshData? Load(FPackageIndex reference)
+        {
+            try
+            {
+                var sm = reference.Load<CUE4Parse.UE4.Assets.Exports.StaticMesh.UStaticMesh>();
+                if (sm is null || !CUE4Parse_Conversion.Meshes.MeshConverter.TryConvert(sm, out var converted) || converted.LODs.Count == 0) return null;
+                var lod = converted.LODs[0];
+                if (lod.Verts is null || lod.Indices is null) return null;
+                var pos = new float[lod.Verts.Length * 3];
+                for (int i = 0; i < lod.Verts.Length; i++)
+                {
+                    var v = lod.Verts[i].Position;
+                    pos[i * 3] = v.X; pos[i * 3 + 1] = v.Y; pos[i * 3 + 2] = v.Z;
+                }
+                uint[] idx = lod.Indices.Value.ToArray();
+                float[] min = [float.MaxValue, float.MaxValue, float.MaxValue], max = [float.MinValue, float.MinValue, float.MinValue];
+                for (int i = 0; i < pos.Length; i++) { min[i % 3] = Math.Min(min[i % 3], pos[i]); max[i % 3] = Math.Max(max[i % 3], pos[i]); }
+                return new MeshData { Name = sm.Name, Positions = pos, Indices = idx, Min = min, Max = max };
+            }
+            catch (Exception e)
+            {
+                Console.Error.WriteLine($"WARN: mesh {reference.Name} not converted ({e.Message})");
+                return null;
+            }
+        }
+    }
+
+    /// Landscape heights per vertex (cm), and holes, from the heightmap and visibility weightmap textures.
+    internal sealed class LandscapeHeights
+    {
+        readonly Dictionary<(int, int), (float Z, bool Hole)> verts = new();
+        readonly List<UObject> pending = new();
+        double ox, oy, oz, quad = 100, zScale = 100;
+        bool hasTransform;
+
+        public void SetTransform(UObject landscape)
+        {
+            var root = landscape.GetOrDefault<FPackageIndex>("RootComponent")?.Load();
+            var loc = root?.GetOrDefault<FVector>("RelativeLocation") ?? FVector.ZeroVector;
+            var scale = root?.GetOrDefault<FVector>("RelativeScale3D", new FVector(1, 1, 1)) ?? new FVector(1, 1, 1);
+            var offset = landscape.GetOrDefault<FIntPoint>("LandscapeSectionOffset");
+            quad = scale.X; zScale = scale.Z;
+            ox = loc.X - offset.X * scale.X; oy = loc.Y - offset.Y * scale.Y; oz = loc.Z;
+            hasTransform = true;
+        }
+
+        // Components are decoded lazily: only the ones a cave box needs.
+        public void Add(UObject component) => pending.Add(component);
+
+        void Decode(UObject c) => Decode(c, (i, j, z, hole) => verts[(i, j)] = (z, hole));
+
+        /// Every landscape vertex not in a hole, in world cm, decoding one component at a time (nothing kept).
+        public void ForEachVertex(Action<double, double, float> sink)
+        {
+            if (!hasTransform) return;
+            foreach (var c in pending)
+            {
+                try { Decode(c, (i, j, z, hole) => { if (!hole) sink(ox + i * quad, oy + j * quad, z); }); }
+                catch (Exception x) { Console.Error.WriteLine($"WARN: landscape component {c.Name} ({x.Message})"); }
+            }
+        }
+
+        void Decode(UObject c, Action<int, int, float, bool> sink)
+        {
+            int bx = c.GetOrDefault<int>("SectionBaseX"), by = c.GetOrDefault<int>("SectionBaseY");
+            int q = c.GetOrDefault<int>("ComponentSizeQuads", 127);
+            var hTex = c.GetOrDefault<FPackageIndex>("HeightmapTexture")?.Load<UTexture2D>();
+            if (hTex is null) return;
+            using var hb = (hTex.Decode() ?? throw new Exception($"heightmap of {c.Name}")).ToSkBitmap();
+            var hs = c.GetOrDefault<FVector4>("HeightmapScaleBias");
+            int hox = (int)Math.Round(hs.Z * hb.Width), hoy = (int)Math.Round(hs.W * hb.Height);
+            var holes = new HashSet<(int, int)>();
+            foreach (var alloc in c.GetOrDefault<FStructFallback[]>("WeightmapLayerAllocations", []))
+            {
+                if (alloc.GetOrDefault<FPackageIndex>("LayerInfo")?.Name != "LandscapeVisibilityLayerInfo") continue;
+                var tex = c.GetOrDefault<FPackageIndex[]>("WeightmapTextures", [])[alloc.GetOrDefault<byte>("WeightmapTextureIndex")].Load<UTexture2D>();
+                if (tex is null) continue;
+                using var wb = (tex.Decode() ?? throw new Exception($"weightmap of {c.Name}")).ToSkBitmap();
+                var ws = c.GetOrDefault<FVector4>("WeightmapScaleBias");
+                int wox = (int)Math.Round(ws.Z * wb.Width), woy = (int)Math.Round(ws.W * wb.Height);
+                int ch = alloc.GetOrDefault<byte>("WeightmapTextureChannel");
+                for (int j = 0; j <= q; j++)
+                    for (int i = 0; i <= q; i++)
+                    {
+                        var px = wb.GetPixel(Math.Min(wox + i, wb.Width - 1), Math.Min(woy + j, wb.Height - 1));
+                        if ((ch switch { 0 => px.Red, 1 => px.Green, 2 => px.Blue, _ => px.Alpha }) > 127) holes.Add((i, j));
+                    }
+            }
+            for (int j = 0; j <= q; j++)
+                for (int i = 0; i <= q; i++)
+                {
+                    var px = hb.GetPixel(Math.Min(hox + i, hb.Width - 1), Math.Min(hoy + j, hb.Height - 1));
+                    int h = px.Red << 8 | px.Green;
+                    // LANDSCAPE_ZSCALE = 1/128; height 32768 = 0
+                    float z = (float)(oz + (h - 32768) / 128.0 * zScale);
+                    sink(bx + i, by + j, z, holes.Contains((i, j)));
+                }
+        }
+
+        public (double Ox, double Oy, double Quad, int I0, int J0, int W, int H, float[] Z, bool[] Hole)? Grid(Box3 b)
+        {
+            if (!hasTransform) return null;
+            int i0 = (int)Math.Floor((b.MinX - ox) / quad), i1 = (int)Math.Ceiling((b.MaxX - ox) / quad);
+            int j0 = (int)Math.Floor((b.MinY - oy) / quad), j1 = (int)Math.Ceiling((b.MaxY - oy) / quad);
+            foreach (var c in pending.ToList())
+            {
+                int bx = c.GetOrDefault<int>("SectionBaseX"), by = c.GetOrDefault<int>("SectionBaseY"), q = c.GetOrDefault<int>("ComponentSizeQuads", 127);
+                if (bx > i1 || bx + q < i0 || by > j1 || by + q < j0) continue;
+                Decode(c);
+                pending.Remove(c);
+            }
+            int w = i1 - i0 + 1, h = j1 - j0 + 1;
+            var z = new float[w * h]; var hole = new bool[w * h];
+            for (int j = 0; j < h; j++)
+                for (int i = 0; i < w; i++)
+                {
+                    if (verts.TryGetValue((i0 + i, j0 + j), out var v)) { z[j * w + i] = v.Z; hole[j * w + i] = v.Hole; }
+                    else { z[j * w + i] = float.NaN; hole[j * w + i] = true; }
+                }
+            return (ox, oy, quad, i0, j0, w, h, z, hole);
+        }
+    }
