+    static List<Group3> Group(List<CaveVolume> volumes)
+    {
+        // Elements far larger than the rest of their volume and over 300 m are broken brushes (see cleanElements in
+        // caves.ts); leave them out of the box.
+        var clean = volumes.Select(v =>
+        {
+            if (v.Elements.Count < 3) return v;
+            var size = v.Elements.Select(e => new[] { e.Hull.Max(p => p[0]) - e.Hull.Min(p => p[0]), e.Hull.Max(p => p[1]) - e.Hull.Min(p => p[1]), e.ZMax - e.ZMin }.Max()).ToList();
+            var median = size.OrderBy(x => x).ElementAt(size.Count / 2);
+            return v with { Elements = v.Elements.Where((_, i) => size[i] <= 5 * median || size[i] <= 30000).ToList() };
+        }).ToList();
+        var boxes = clean.Select(BoxOf).ToList();
+        var parent = Enumerable.Range(0, boxes.Count).ToArray();
+        int Find(int i) => parent[i] == i ? i : parent[i] = Find(parent[i]);
+        for (int i = 0; i < boxes.Count; i++)
+            for (int j = i + 1; j < boxes.Count; j++)
+            {
+                var a = boxes[i]; var b = boxes[j];
+                if (a.MinX - Gap <= b.MaxX && a.MaxX + Gap >= b.MinX && a.MinY - Gap <= b.MaxY && a.MaxY + Gap >= b.MinY && a.MinZ - Gap <= b.MaxZ && a.MaxZ + Gap >= b.MinZ)
+                    parent[Find(i)] = Find(j);
+            }
