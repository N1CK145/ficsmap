+            using var f = File.Create(path);
+            using var w = new BinaryWriter(f);
+            w.Write(0x46546C67u); w.Write(2u); w.Write((uint)(12 + 8 + json.Length + jsonPad + 8 + bin.Length));
+            w.Write((uint)(json.Length + jsonPad)); w.Write(0x4E4F534Au); w.Write(json); for (int i = 0; i < jsonPad; i++) w.Write((byte)0x20);
+            w.Write((uint)bin.Length); w.Write(0x004E4942u); w.Write(bin.ToArray());
+            return triangles;
+        }
+
+        static void Align(MemoryStream s) { while (s.Length % 4 != 0) s.WriteByte(0); }
+
+        // glTF column-major 4x4 of P . M . P^-1: P swaps UE Y and Z and turns cm into m. Mesh vertices are
+        // already in glTF axes and metres, so the linear part is the swapped L and the translation is P . T.
+        static double[] GltfMatrix(Xf t)
+        {
+            int[] perm = [0, 2, 1]; // glTF axis k = UE axis perm[k]
+            var m = new double[16];
+            for (int c = 0; c < 3; c++)
+                for (int r = 0; r < 3; r++)
+                    m[c * 4 + r] = t.L[perm[r] * 3 + perm[c]];
+            m[12] = t.T[0] / 100; m[13] = t.T[2] / 100; m[14] = t.T[1] / 100; m[15] = 1;
+            return m;
+        }
+    }
+}
