+
+// Height grids of the whole map (the minimap capture's square), written by --heightmap-out:
+//   top.f32        highest solid surface per cell: landscape (without holes), static meshes, spline meshes and
+//                  instanced meshes except foliage (cm, float32 LE, row-major from minX/minY, NaN = nothing);
+//   landscape.f32  the UE landscape alone;
+//   foliage.f32    the highest foliage instance (trees, bushes, small rocks), for comparison;
+//   height-data.f32 the game's own top-down height texture (HeightData_Test, normalised 0..1, no scale), as cooked;
+//   heightmap.json the grid (cell size, origin, size) and counts.
+// A cell takes the maximum of every triangle sampled at its centre and of every vertex inside it, so small or
+// steep triangles are not lost.
+static class Heightmap
+{
+    const double Cell = 200;
+
+    public record Info(
+        [property: JsonPropertyName("cell")] double Cell,
+        [property: JsonPropertyName("minX")] double MinX,
+        [property: JsonPropertyName("minY")] double MinY,
+        [property: JsonPropertyName("width")] int Width,
+        [property: JsonPropertyName("height")] int Height,
+        [property: JsonPropertyName("counts")] SortedDictionary<string, long> Counts,
+        [property: JsonPropertyName("heightData")] object? HeightData);
+
+    sealed class Grid(double minX, double minY, int w, int h)
+    {
+        public readonly float[] Z = Enumerable.Repeat(float.NaN, w * h).ToArray();
+
+        public void Point(double x, double y, double z)
+        {
+            int i = (int)Math.Floor((x - minX) / Cell), j = (int)Math.Floor((y - minY) / Cell);
+            if (i < 0 || j < 0 || i >= w || j >= h) return;
+            int k = j * w + i;
+            if (!(Z[k] >= z)) Z[k] = (float)z;
+        }
+
+        public void Triangle(double ax, double ay, double az, double bx, double by, double bz, double cx, double cy, double cz)
+        {
+            Point(ax, ay, az); Point(bx, by, bz); Point(cx, cy, cz);
+            double det = (by - cy) * (ax - cx) + (cx - bx) * (ay - cy);
+            if (Math.Abs(det) < 1e-6) return;
+            int i0 = Math.Max(0, (int)Math.Ceiling((Math.Min(ax, Math.Min(bx, cx)) - minX) / Cell - 0.5));
+            int i1 = Math.Min(w - 1, (int)Math.Floor((Math.Max(ax, Math.Max(bx, cx)) - minX) / Cell - 0.5));
+            int j0 = Math.Max(0, (int)Math.Ceiling((Math.Min(ay, Math.Min(by, cy)) - minY) / Cell - 0.5));
+            int j1 = Math.Min(h - 1, (int)Math.Floor((Math.Max(ay, Math.Max(by, cy)) - minY) / Cell - 0.5));
+            for (int j = j0; j <= j1; j++)
+            {
+                double py = minY + (j + 0.5) * Cell;
+                for (int i = i0; i <= i1; i++)
+                {
+                    double px = minX + (i + 0.5) * Cell;
+                    double l1 = ((by - cy) * (px - cx) + (cx - bx) * (py - cy)) / det;
+                    double l2 = ((cy - ay) * (px - cx) + (ax - cx) * (py - cy)) / det;
+                    double l3 = 1 - l1 - l2;
+                    if (l1 < 0 || l2 < 0 || l3 < 0) continue;
+                    double z = l1 * az + l2 * bz + l3 * cz;
+                    int k = j * w + i;
+                    if (!(Z[k] >= z)) Z[k] = (float)z;
+                }
+            }
+        }
+
+        public void Mesh(CaveGeometry.MeshData mesh, CaveGeometry.Xf t)
+        {
+            var p = mesh.Positions;
+            var wv = new double[p.Length];
+            for (int v = 0; v < p.Length; v += 3)
+            {
+                var q = t.Apply(p[v], p[v + 1], p[v + 2]);
+                wv[v] = q[0]; wv[v + 1] = q[1]; wv[v + 2] = q[2];
+            }
+            Baked(wv, mesh.Indices);
+        }
+
+        public void Baked(IReadOnlyList<double> wv, uint[] idx)
+        {
+            for (int k = 0; k + 2 < idx.Length; k += 3)
+            {
+                long a = idx[k] * 3L, b = idx[k + 1] * 3L, c = idx[k + 2] * 3L;
+                Triangle(wv[(int)a], wv[(int)a + 1], wv[(int)a + 2], wv[(int)b], wv[(int)b + 1], wv[(int)b + 2], wv[(int)c], wv[(int)c + 1], wv[(int)c + 2]);
+            }
+        }
+
+        public void Save(string path)
+        {
+            var bytes = new byte[Z.Length * 4];
+            Buffer.BlockCopy(Z, 0, bytes, 0, bytes.Length);
+            File.WriteAllBytes(path, bytes);
+        }
+    }
+
+    public static Info Write(IFileProvider provider, MapBounds bounds, string dir)
+    {
+        Directory.CreateDirectory(dir);
+        int w = (int)Math.Ceiling((bounds.MaxX - bounds.MinX) / Cell), h = (int)Math.Ceiling((bounds.MaxY - bounds.MinY) / Cell);
+        var top = new Grid(bounds.MinX, bounds.MinY, w, h);
+        var ground = new Grid(bounds.MinX, bounds.MinY, w, h);
+        var foliage = new Grid(bounds.MinX, bounds.MinY, w, h);
+        var counts = new SortedDictionary<string, long>(StringComparer.Ordinal);
+        void Count(string key, long n = 1) => counts[key] = counts.GetValueOrDefault(key) + n;
+
+        var meshCache = new Dictionary<string, CaveGeometry.MeshData?>(StringComparer.OrdinalIgnoreCase);
+        CaveGeometry.MeshData? MeshOf(FPackageIndex r)
+        {
+            var path = r.ResolvedObject?.GetPathName() ?? r.Name;
+            if (!meshCache.TryGetValue(path, out var m)) meshCache[path] = m = CaveGeometry.MeshData.Load(r);
+            return m;
+        }
+
+        var landscape = new CaveGeometry.LandscapeHeights();
+        foreach (var file in provider.Files.Keys
+                     .Where(k => k.StartsWith(PickupContents.CellsDir, StringComparison.OrdinalIgnoreCase) && k.EndsWith(".umap"))
+                     .Prepend("FactoryGame/Content/FactoryGame/Map/GameLevel01/Persistent_Level.umap"))
+        {
+            List<UObject> exports;
+            try { exports = provider.LoadPackage(file).GetExports().ToList(); }
+            catch { continue; }
+            CaveGeometry.Xf.ClearCache();
+            foreach (var e in exports)
+            {
+                if (e.ExportType == "Landscape") landscape.SetTransform(e);
+                if (e.ExportType == "LandscapeComponent") landscape.Add(e);
+                bool ism = e is UInstancedStaticMeshComponent;
+                if (!ism && e.ExportType is not ("StaticMeshComponent" or "SplineMeshComponent")) continue;
+                var owner = e.Outer?.Name.Text ?? "";
+                if (owner.StartsWith("WPHLOD", StringComparison.Ordinal) || CaveGeometry.Skipped(owner)) { Count("skipped owner"); continue; }
+                if (!e.GetOrDefault("bVisible", true) || e.GetOrDefault("bHiddenInGame", false)) { Count("skipped hidden"); continue; }
+                var meshRef = e.GetOrDefault<FPackageIndex>("StaticMesh");
+                if (meshRef is null || meshRef.IsNull) meshRef = e.Template?.Load()?.GetOrDefault<FPackageIndex>("StaticMesh");
+                if (meshRef is null || meshRef.IsNull || CaveGeometry.SkippedMesh(meshRef.Name)) { Count("skipped mesh"); continue; }
+                var mesh = MeshOf(meshRef);
+                if (mesh is null) continue;
+                if (Math.Max(mesh.Max[0] - mesh.Min[0], Math.Max(mesh.Max[1] - mesh.Min[1], mesh.Max[2] - mesh.Min[2])) > CaveGeometry.MaxExtent) { Count("skipped huge"); continue; }
+                CaveGeometry.Xf t;
+                try { t = CaveGeometry.Xf.World(e); }
+                catch (Exception x) { Console.Error.WriteLine($"WARN: transform of {owner}.{e.Name} ({x.Message})"); continue; }
+                if (ism)
+                {
+                    bool isFoliage = e.ExportType.Contains("Foliage", StringComparison.Ordinal) || owner.StartsWith("InstancedFoliageActor", StringComparison.Ordinal);
+                    var grid = isFoliage ? foliage : top;
+                    var instances = ((UInstancedStaticMeshComponent)e).PerInstanceSMData ?? [];
+                    foreach (var inst in instances) grid.Mesh(mesh, t.Then(InstanceXf(inst.TransformData)));
+                    Count($"{e.ExportType} instances", instances.Length);
+                    continue;
+                }
+                if (e.ExportType == "SplineMeshComponent")
+                {
+                    var baked = CaveGeometry.SplineMesh.Deform(e, mesh, t);
+                    if (baked is null) continue;
+                    top.Baked(Array.ConvertAll(baked, v => (double)v), mesh.Indices);
+                    Count("SplineMeshComponent");
+                    continue;
+                }
+                var wb = t.Bounds(mesh.Min, mesh.Max);
+                if (Math.Max(wb.MaxX - wb.MinX, Math.Max(wb.MaxY - wb.MinY, wb.MaxZ - wb.MinZ)) > CaveGeometry.MaxExtent) { Count("skipped huge"); continue; }
+                top.Mesh(mesh, t);
+                Count("StaticMeshComponent");
+            }
+        }
+        landscape.ForEachVertex((x, y, z) => { ground.Point(x, y, z); top.Point(x, y, z); Count("landscape vertices"); });
+        // Landscape quads are 1 m; with 2 m cells every cell has vertices, so points are enough.
+
+        top.Save(Path.Combine(dir, "top.f32"));
+        ground.Save(Path.Combine(dir, "landscape.f32"));
+        foliage.Save(Path.Combine(dir, "foliage.f32"));
+        object? heightData = null;
+        try { heightData = HeightDataTexture(provider, Path.Combine(dir, "height-data.f32")); }
+        catch (Exception x) { Console.Error.WriteLine($"WARN: HeightData_Test not exported ({x.Message})"); }
+        var info = new Info(Cell, bounds.MinX, bounds.MinY, w, h, counts, heightData);
+        File.WriteAllText(Path.Combine(dir, "heightmap.json"), JsonSerializer.Serialize(info, Json.Options));
+        foreach (var (k, v) in counts) Console.WriteLine($"  {k}: {v}");
+        return info;
+    }
+
+    static CaveGeometry.Xf InstanceXf(FTransform tr)
+    {
+        var m = tr.ToMatrixWithScale();
+        // FMatrix rows are the transformed axes (row vectors); Xf.L is column-vector form, so transpose.
+        return new CaveGeometry.Xf(
+            [m.M00, m.M10, m.M20, m.M01, m.M11, m.M21, m.M02, m.M12, m.M22],
+            [m.M30, m.M31, m.M32]);
+    }
+
+    /// The game's top-down height texture next to the map slices: half floats 0..1, row 0 = north edge (min Y).
+    static object HeightDataTexture(IFileProvider provider, string path)
+    {
+        var tex = provider.LoadPackageObject<UTexture2D>("FactoryGame/Content/FactoryGame/Interface/UI/Assets/MapTest/HeightData_Test.HeightData_Test");
+        var mip = tex.GetFirstMip() ?? throw new Exception("no mip");
+        var data = mip.BulkData?.Data ?? throw new Exception("no bulk data");
+        int n = mip.SizeX * mip.SizeY;
+        string format = tex.Format.ToString();
+        var f = new float[n];
+        if (format == "PF_R16F") for (int k = 0; k < n; k++) f[k] = (float)BitConverter.ToHalf(data, k * 2);
+        else if (format == "PF_G16") for (int k = 0; k < n; k++) f[k] = BitConverter.ToUInt16(data, k * 2) / 65535f;
+        else throw new Exception($"format {format}");
+        var bytes = new byte[n * 4];
+        Buffer.BlockCopy(f, 0, bytes, 0, bytes.Length);
+        File.WriteAllBytes(path, bytes);
+        return new { format, width = mip.SizeX, height = mip.SizeY };
+    }
+}
