+// The game's map areas (the regions whose name the game shows), from the FGMapAreaTexture asset
+// MapareatexturePersistentLevel that the level's minimap capture actor references (mMapAreaTexture): a byte raster
+// (mAreaData, mDataWidth wide, row-major) of palette indices, and per index its colour and area class
+// (mColorPalette, mColorToArea with the area's pixel bounds). The class names do not always say the area's name
+// (Area_Savanna_* is shown as Rocky Desert, Area_RedJungle_2 as Jungle Spires): the name is the class default's
+// mDisplayName, a string table entry, resolved here in English and German from the game's AllStringTables.
+// Written by --map-areas-out as areas.u8 (the raster as is) and areas.json. The raster's world extent is not in
+// the asset; it is the minimap capture's square (checked against the map image, see README).
+static class MapAreas
+{
+    const string Asset = "FactoryGame/Content/FactoryGame/Interface/UI/Minimap/MapAreaPersistenLevel/MapareatexturePersistentLevel.MapareatexturePersistentLevel";
+
+    public record Area(
+        [property: JsonPropertyName("index")] int Index,
+        [property: JsonPropertyName("color")] string Color,
+        [property: JsonPropertyName("class")] string Class,
+        [property: JsonPropertyName("nameKey")] string? NameKey,
+        [property: JsonPropertyName("name")] string? Name,
+        [property: JsonPropertyName("nameDe")] string? NameDe,
+        [property: JsonPropertyName("bounds")] int[] Bounds);
+
+    public record Info(
+        [property: JsonPropertyName("width")] int Width,
+        [property: JsonPropertyName("height")] int Height,
+        [property: JsonPropertyName("areas")] List<Area> Areas);
+
+    public static Info Write(IFileProvider provider, string dir)
+    {
+        Directory.CreateDirectory(dir);
+        var tex = provider.LoadPackageObject(Asset);
+        var data = tex.GetOrDefault<byte[]>("mAreaData") ?? throw new Exception("mAreaData missing");
+        int width = tex.GetOrDefault<int>("mDataWidth");
+        if (width <= 0 || data.Length % width != 0) throw new Exception($"mAreaData {data.Length} bytes, width {width}");
+        var palette = tex.GetOrDefault<FColor[]>("mColorPalette", []);
+        var pairs = tex.GetOrDefault<FStructFallback[]>("mColorToArea", []);
+        var en = StringTable(provider, "en-US");
+        var de = StringTable(provider, "de");
+        var areas = new List<Area>();
+        for (int i = 0; i < pairs.Length; i++)
+        {
+            var pair = pairs[i];
+            var areaRef = pair.GetOrDefault<FPackageIndex>("MapArea");
+            var cls = areaRef?.Name ?? "";
+            var color = i < palette.Length ? palette[i].Hex : "";
+            var (table, key) = DisplayNameKey(areaRef);
+            string? nameEn = null, nameDe = null;
+            if (table is not null && key is not null)
+            {
+                nameEn = en.GetValueOrDefault((table, key));
+                nameDe = de.GetValueOrDefault((table, key));
+            }
+            areas.Add(new Area(i, color, cls, key, nameEn, nameDe, [pair.GetOrDefault<int>("MinX"), pair.GetOrDefault<int>("MinY"), pair.GetOrDefault<int>("MaxX"), pair.GetOrDefault<int>("MaxY")]));
+        }
+        File.WriteAllBytes(Path.Combine(dir, "areas.u8"), data);
+        foreach (var a in areas.Where(a => a.Class is not ("" or "None") && a.Name is null)) Console.Error.WriteLine($"WARN: map area {a.Class} has no display name");
+        var info = new Info(width, data.Length / width, areas);
+        File.WriteAllText(Path.Combine(dir, "areas.json"), JsonSerializer.Serialize(info, Json.Options));
+        return info;
+    }
+
+    /// The string table entry (table id, key) of an area class's mDisplayName, from its class default object.
+    static (string?, string?) DisplayNameKey(FPackageIndex? areaRef)
+    {
+        if (areaRef is null || areaRef.IsNull) return (null, null);
+        try
+        {
+            var cls = areaRef.Load<CUE4Parse.UE4.Objects.Engine.UBlueprintGeneratedClass>();
+            var cdo = cls?.ClassDefaultObject.Load();
+            var text = cdo?.GetOrDefault<CUE4Parse.UE4.Objects.Core.i18N.FText>("mDisplayName");
+            if (text?.TextHistory is CUE4Parse.UE4.Objects.Core.i18N.FTextHistory.StringTableEntry st) return (st.TableId.Text, st.Key);
+        }
+        catch (Exception x) { Console.Error.WriteLine($"WARN: display name of {areaRef.Name} ({x.Message})"); }
+        return (null, null);
+    }
+
+    /// The game's string tables in one culture: (table id, key) -> text.
+    static Dictionary<(string, string), string> StringTable(IFileProvider provider, string culture)
+    {
+        var path = $"FactoryGame/Content/Localization/AllStringTables/{culture}/AllStringTables.locres";
+        var result = new Dictionary<(string, string), string>();
+        if (!provider.Files.TryGetValue(path, out var file)) { Console.Error.WriteLine($"WARN: {path} not found"); return result; }
+        var loc = new CUE4Parse.UE4.Localization.FTextLocalizationResource(new CUE4Parse.UE4.Readers.FByteArchive(path, file.Read()));
+        foreach (var (ns, keys) in loc.Entries)
+            foreach (var (key, val) in keys) result[(ns.Str, key.Str)] = val.LocalizedString;
+        return result;
+    }
+}
+
+// Values of the transport vehicles that the game's CommunityResources/Docs JSON does not contain, read from the
+// class default objects of the vehicle blueprints (written by --transport-out as transport.json):
+//   inventorySize             mInventorySize (also in the Docs; written for cross-checking)
+//   isFluidStorage            mIsFluidStorageInventory
+//   fluidStackSizeMultiplier  mFluidStackSizeMultiplier: a fluid slot holds the fluid's stack size times this
+//   dockingSequenceDuration,  mDockingSequenceDuration, mTakeoffSequenceDuration of the drone (seconds)
+//   takeoffSequenceDuration
+//   straightPathSpeedLimit    the autopilot's mCurvatureSpeedLimitCurve at curvature 0 (a straight path), m/s
+//   tractionSpeedLimit        the speed (m/s) at which the autopilot's mTractiveEffortCurve (m/s -> kN) reaches 0:
+//                             the engine pulls no more, so the vehicle gets no faster on level ground
+//   droneFuelTypes            the drone's mFuelTypes: item class and TravelSpeed (cm/s, the cruising speed) per fuel
+// Blueprint defaults are stored as deltas, so a value missing on a class is taken from its parent blueprint
+// (BP_FluidTruck inherits from BP_Truck). null means no blueprint in the chain sets it (a C++ default, not in the paks).
+static class TransportData
+{
+    const string Root = "FactoryGame/Content/FactoryGame/Buildable/";
+    static readonly string[] Vehicles =
+    [
+        "Vehicle/Tractor/BP_Tractor", "Vehicle/Truck/BP_Truck", "Vehicle/Truck/BP_FluidTruck",
+        "Vehicle/Explorer/BP_Explorer", "Vehicle/Train/Wagon/BP_FreightWagon", "Factory/DroneStation/BP_DroneTransport",
+    ];
+
+    public record DroneFuel(
+        [property: JsonPropertyName("item")] string Item,
+        [property: JsonPropertyName("travelSpeed")] float? TravelSpeed);
+
+    public record Vehicle(
+        [property: JsonPropertyName("class")] string Class,
+        [property: JsonPropertyName("asset")] string Asset,
+        [property: JsonPropertyName("inventorySize")] int? InventorySize,
+        [property: JsonPropertyName("isFluidStorage")] bool? IsFluidStorage,
+        [property: JsonPropertyName("fluidStackSizeMultiplier")] int? FluidStackSizeMultiplier,
+        [property: JsonPropertyName("dockingSequenceDuration")] float? DockingSequenceDuration,
+        [property: JsonPropertyName("takeoffSequenceDuration")] float? TakeoffSequenceDuration,
+        [property: JsonPropertyName("straightPathSpeedLimit")] float? StraightPathSpeedLimit,
+        [property: JsonPropertyName("tractionSpeedLimit")] float? TractionSpeedLimit,
+        [property: JsonPropertyName("droneFuelTypes")] List<DroneFuel>? DroneFuelTypes);
+
+    public record Info([property: JsonPropertyName("vehicles")] List<Vehicle> Vehicles);
+
+    public static Info Read(IFileProvider provider)
+    {
+        var list = new List<Vehicle>();
+        foreach (var path in Vehicles)
+        {
+            var chain = Chain(provider, Root + path);
+            if (chain.Count == 0) throw new Exception($"Vehicle blueprint {path} not found");
+            list.Add(new Vehicle(
+                chain[0].Class, "/Game/FactoryGame/Buildable/" + path,
+                First(chain, c => c.Cdo.TryGetValue(out int v, "mInventorySize") ? v : (int?)null),
+                First(chain, c => c.Cdo.TryGetValue(out bool v, "mIsFluidStorageInventory") ? v : (bool?)null),
+                First(chain, c => c.Cdo.TryGetValue(out int v, "mFluidStackSizeMultiplier") ? v : (int?)null),
+                First(chain, c => c.Cdo.TryGetValue(out float v, "mDockingSequenceDuration") ? v : (float?)null),
+                First(chain, c => c.Cdo.TryGetValue(out float v, "mTakeoffSequenceDuration") ? v : (float?)null),
+                First(chain, c => SpeedLimitAtZero(c.Autopilot)),
+                First(chain, c => TractionZero(c.Autopilot)),
+                chain.Select(c => DroneFuels(c.Cdo)).FirstOrDefault(f => f is not null)));
+        }
+        return new Info(list);
+    }
+
+    record Level(string Class, UObject Cdo, UObject? Autopilot);
+
+    static T? First<T>(List<Level> chain, Func<Level, T?> get) where T : struct
+    {
+        foreach (var c in chain) if (get(c) is T v) return v;
+        return null;
+    }
+
+    /// The blueprint and its parent blueprints, each with its class default object and autopilot component template.
+    static List<Level> Chain(IFileProvider provider, string package)
+    {
+        var chain = new List<Level>();
+        for (int depth = 0; depth < 10 && package.Length > 0; depth++)
+        {
+            if (!provider.TryLoadPackage(package + ".uasset", out var pkg)) break;
+            var exports = pkg.GetExports().ToList();
+            var cls = exports.OfType<CUE4Parse.UE4.Objects.Engine.UBlueprintGeneratedClass>().FirstOrDefault();
+            if (cls is null) break;
+            var cdo = cls.ClassDefaultObject.Load();
+            if (cdo is null) break;
+            // The component template the class default object owns (one per blueprint package).
+            var autopilot = exports.FirstOrDefault(e => e.Name == "AutopilotComponent" && e.ExportType == "FGVehicleAutopilotComponent");
+            chain.Add(new Level(cls.Name, cdo, autopilot));
+            var super = cls.SuperStruct?.ResolvedObject;
+            var superPackage = super?.Package?.Name;
+            if (superPackage is null || !superPackage.StartsWith("/Game/")) break;
+            var next = "FactoryGame/Content/FactoryGame/" + superPackage["/Game/FactoryGame/".Length..];
+            // The root blueprint (BP_WheeledVehicle) resolves its native parent to its own package: stop there.
+            if (next.Equals(package, StringComparison.OrdinalIgnoreCase)) break;
+            package = next;
+        }
+        return chain;
+    }
+
+    /// The keys of a runtime float curve property: its external curve asset, else the curve stored inline.
+    /// Empty when the component does not set the property.
+    static CUE4Parse.UE4.Objects.Engine.Curves.FRichCurveKey[] CurveKeys(UObject? owner, string property)
+    {
+        if (owner is null || !owner.TryGetValue(out FStructFallback curve, property)) return [];
+        var external = curve.GetOrDefault<FPackageIndex>("ExternalCurve");
+        if (external is not null && !external.IsNull)
+            return external.Load()?.GetOrDefault<CUE4Parse.UE4.Objects.Engine.Curves.FRichCurve>("FloatCurve")?.Keys ?? [];
+        return curve.GetOrDefault<CUE4Parse.UE4.Objects.Engine.Curves.FRichCurve>("EditorCurveData")?.Keys ?? [];
+    }
+
+    /// The first key of the autopilot's curvature speed limit curve, if it is at curvature 0.
+    static float? SpeedLimitAtZero(UObject? autopilot)
+    {
+        var keys = CurveKeys(autopilot, "mCurvatureSpeedLimitCurve");
+        if (keys.Length == 0) return null;
+        return keys[0].Time == 0 ? keys[0].Value : null;
+    }
+
+    /// The speed at which the tractive effort curve first drops to 0 or below after being positive: the key's speed
+    /// when the key is 0 (Tractor, Explorer), else linear between the two keys around the crossing (the Truck's
+    /// last key is -3.5e-7). In 1.2.5.0 the cubic segment before that key stays positive, so this is where it reaches 0.
+    static float? TractionZero(UObject? autopilot)
+    {
+        var keys = CurveKeys(autopilot, "mTractiveEffortCurve");
+        for (int i = 1; i < keys.Length; i++)
+        {
+            var (a, b) = (keys[i - 1], keys[i]);
+            if (a.Value <= 0 || b.Value > 0) continue;
+            return b.Value == 0 ? b.Time : a.Time + (b.Time - a.Time) * a.Value / (a.Value - b.Value);
+        }
+        return null;
+    }
+
+    /// The drone's fuel types (item class and travel speed in cm/s); null for a class that does not set mFuelTypes.
+    /// A travel speed the blueprint does not set is written as null (the build then fails rather than guess).
+    static List<DroneFuel>? DroneFuels(UObject cdo)
+    {
+        if (!cdo.TryGetValue(out FStructFallback[] fuels, "mFuelTypes")) return null;
+        return fuels.Select(f => new DroneFuel(
+            f.GetOrDefault<FPackageIndex>("Item")?.Name ?? throw new Exception("Drone fuel type without an item"),
+            f.TryGetValue(out float speed, "TravelSpeed") ? speed : null)).ToList();
+    }
+}
