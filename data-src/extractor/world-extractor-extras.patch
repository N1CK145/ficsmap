+    static Box3 BoxOf(CaveVolume v)
+    {
+        var pts = v.Elements.SelectMany(e => e.Hull).ToList();
+        return new(pts.Min(p => p[0]), pts.Min(p => p[1]), v.Elements.Min(e => e.ZMin), pts.Max(p => p[0]), pts.Max(p => p[1]), v.Elements.Max(e => e.ZMax));
