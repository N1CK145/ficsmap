+    /// A static mesh's local bounds (cheap, from the render data) and, on first use, its geometry.
+    public sealed class MeshRef
+    {
+        public required float[] Min, Max;
+        public required FPackageIndex Reference;
+        MeshData? data; bool loaded;
+        public MeshData? Data { get { if (!loaded) { data = MeshData.Load(Reference); loaded = true; } return data; } }
+
+        public static MeshRef? Load(FPackageIndex reference)
+        {
+            try
+            {
+                var sm = reference.Load<CUE4Parse.UE4.Assets.Exports.StaticMesh.UStaticMesh>();
+                var bounds = sm?.RenderData?.Bounds;
+                if (bounds is null) return null;
+                var o = bounds.Origin; var x = bounds.BoxExtent;
+                return new MeshRef { Reference = reference, Min = [o.X - x.X, o.Y - x.Y, o.Z - x.Z], Max = [o.X + x.X, o.Y + x.Y, o.Z + x.Z] };
+            }
+            catch { return null; }
+        }
+    }
