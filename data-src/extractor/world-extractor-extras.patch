+    /// Landscape heights per vertex (cm), and holes, from the heightmap and visibility weightmap textures.
+    internal sealed class LandscapeHeights
+    {
+        readonly Dictionary<(int, int), (float Z, bool Hole)> verts = new();
+        readonly List<UObject> pending = new();
+        double ox, oy, oz, quad = 100, zScale = 100;
+        bool hasTransform;
+
+        public void SetTransform(UObject landscape)
+        {
+            var root = landscape.GetOrDefault<FPackageIndex>("RootComponent")?.Load();
+            var loc = root?.GetOrDefault<FVector>("RelativeLocation") ?? FVector.ZeroVector;
+            var scale = root?.GetOrDefault<FVector>("RelativeScale3D", new FVector(1, 1, 1)) ?? new FVector(1, 1, 1);
+            var offset = landscape.GetOrDefault<FIntPoint>("LandscapeSectionOffset");
+            quad = scale.X; zScale = scale.Z;
+            ox = loc.X - offset.X * scale.X; oy = loc.Y - offset.Y * scale.Y; oz = loc.Z;
+            hasTransform = true;
+        }
+
+        // Components are decoded lazily: only the ones a cave box needs.
+        public void Add(UObject component) => pending.Add(component);
+
+        void Decode(UObject c) => Decode(c, (i, j, z, hole) => verts[(i, j)] = (z, hole));
+
+        /// Every landscape vertex not in a hole, in world cm, decoding one component at a time (nothing kept).
+        public void ForEachVertex(Action<double, double, float> sink)
+        {
+            if (!hasTransform) return;
+            foreach (var c in pending)
+            {
+                try { Decode(c, (i, j, z, hole) => { if (!hole) sink(ox + i * quad, oy + j * quad, z); }); }
+                catch (Exception x) { Console.Error.WriteLine($"WARN: landscape component {c.Name} ({x.Message})"); }
+            }
+        }
