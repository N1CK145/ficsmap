+    /// One static mesh's render geometry (UE local cm), from the first LOD.
+    public sealed class MeshData
+    {
+        public required string Name;
+        public required float[] Positions; // x, y, z per vertex
+        public required uint[] Indices;
+        public required float[] Min, Max;
+
+        public static MeshData? Load(FPackageIndex reference)
+        {
+            try
+            {
+                var sm = reference.Load<CUE4Parse.UE4.Assets.Exports.StaticMesh.UStaticMesh>();
+                if (sm is null || !CUE4Parse_Conversion.Meshes.MeshConverter.TryConvert(sm, out var converted) || converted.LODs.Count == 0) return null;
+                var lod = converted.LODs[0];
+                if (lod.Verts is null || lod.Indices is null) return null;
+                var pos = new float[lod.Verts.Length * 3];
+                for (int i = 0; i < lod.Verts.Length; i++)
+                {
+                    var v = lod.Verts[i].Position;
+                    pos[i * 3] = v.X; pos[i * 3 + 1] = v.Y; pos[i * 3 + 2] = v.Z;
+                }
+                uint[] idx = lod.Indices.Value.ToArray();
+                float[] min = [float.MaxValue, float.MaxValue, float.MaxValue], max = [float.MinValue, float.MinValue, float.MinValue];
+                for (int i = 0; i < pos.Length; i++) { min[i % 3] = Math.Min(min[i % 3], pos[i]); max[i % 3] = Math.Max(max[i % 3], pos[i]); }
+                return new MeshData { Name = sm.Name, Positions = pos, Indices = idx, Min = min, Max = max };
+            }
+            catch (Exception e)
+            {
+                Console.Error.WriteLine($"WARN: mesh {reference.Name} not converted ({e.Message})");
+                return null;
+            }
+        }
+    }
