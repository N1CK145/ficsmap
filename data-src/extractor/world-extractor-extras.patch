+            Align(bin);
+            var gltf = new Dictionary<string, object>
+            {
+                ["asset"] = new { version = "2.0", generator = "ficsmap world-extractor (CaveGeometry)" },
+                ["scene"] = 0,
+                ["scenes"] = new[] { new { nodes = Enumerable.Range(0, nodes.Count).ToArray() } },
+                ["nodes"] = nodes, ["meshes"] = meshes, ["accessors"] = accessors, ["bufferViews"] = bufferViews,
