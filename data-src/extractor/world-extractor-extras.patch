+/** Decoding and scaling of icon textures, shared by the map icons and the descriptor icons. */
+static class IconImage
+{
+    public static SKBitmap Decode(UTexture2D texture) =>
+        (texture.Decode() ?? throw new Exception("decode returned null")).ToSkBitmap();
+
+    /** The bitmap scaled to a size x size square and encoded. */
+    public static byte[] Encode(SKBitmap bitmap, int size, SKEncodedImageFormat format, int quality)
+    {
+        using var scaled = new SKBitmap(new SKImageInfo(size, size, SKColorType.Rgba8888, SKAlphaType.Premul));
+        bitmap.ScalePixels(scaled, SKFilterQuality.High);
+        using var image = SKImage.FromBitmap(scaled);
+        using var data = image.Encode(format, quality) ?? throw new Exception($"{format} encoding is not available in this SkiaSharp build.");
+        return data.ToArray();
+    }
+
+    /** A square copy with the bitmap centred on a transparent background (icons are square; this only guards odd ones). */
+    public static SKBitmap Square(SKBitmap bitmap)
+    {
+        int side = Math.Max(bitmap.Width, bitmap.Height);
+        var square = new SKBitmap(new SKImageInfo(side, side, SKColorType.Rgba8888, SKAlphaType.Premul));
+        using var canvas = new SKCanvas(square);
+        canvas.Clear(SKColors.Transparent);
+        canvas.DrawBitmap(bitmap, (side - bitmap.Width) / 2f, (side - bitmap.Height) / 2f);
+        return square;
+    }
+}
