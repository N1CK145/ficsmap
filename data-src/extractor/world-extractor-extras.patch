+// Everything solid around each cave, for sampling the real cave shape and for 3D previews:
+//   <dir>/index.json      the caves: id, world bounding box (cm), the cave volumes they consist of, file, counts
+//   <dir>/<id>.glb        glTF 2.0 binary: every static or spline mesh component whose world bounds touch the cave's box
+//                         (one glTF mesh per static mesh, one node per placed instance), plus the landscape inside
+//                         the box as a 1 m grid mesh without its holes (node "landscape").
+// A cave is a group of cave volumes (CaveData) whose boxes overlap or are within 10 m of each other.
+// Coordinates: glTF metres, right-handed, Y up: glTF (x, y, z) = UE (X, Z, Y) / 100. Node extras carry the UE
+// actor and mesh names. Foliage instances (small rocks, plants) are not included.
+static class CaveGeometry
+{
+    const double Gap = 1000, MarginXY = 3000, MarginBelow = 3000, MarginAbove = 6000;
+
+    public static CaveGeometryIndex Write(IFileProvider provider, Caves caves, string dir)
+    {
