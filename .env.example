# Copy to .env next to docker-compose.yml, fill in, chmod 600. Never commit it.
# Generate secrets with: openssl rand -base64 48

# Public base URL (Discord redirect and invite links)
PUBLIC_URL=https://ficsmap.example.com
# Discord application (https://discord.com/developers/applications); redirect URI <PUBLIC_URL>/auth/discord/callback
DISCORD_CLIENT_ID=change-me-discord-client-id
DISCORD_CLIENT_SECRET=change-me-discord-client-secret
# Comma-separated Discord user IDs that may log in without an invite and confirm rollbacks (owners)
OWNER_DISCORD_IDS=change-me-your-discord-user-id
# At least 32 characters each, different from each other
SESSION_SECRET=change-me-session-secret-at-least-32-chars
INVITE_JWT_SECRET=change-me-invite-secret-at-least-32-chars
# IP of your reverse proxy, whose X-Forwarded-* headers are trusted (empty without a proxy)
TRUST_PROXY=
# Keep true behind HTTPS; false only for plain-HTTP testing
COOKIE_SECURE=true
# Log level: fatal, error, warn, info, debug, trace
LOG_LEVEL=info

# Read by docker compose, not by the app:
# Host port
FICSMAP_PORT=3000
# Pin a version for a rollback (e.g. 0.1.0); leave unset for the newest release
# FICSMAP_VERSION=

# Image defaults, normally left alone: PORT=3000, DB_PATH=/data/app.db, DATASET_DIR=/app/data,
# WEB_DIR=/app/dist/web, DATASET_VERSION=auto-detected (the only folder in DATASET_DIR)
