# Local development values. Copy to .env.local (git-ignored): cp .env.development.example .env.local
# `npm run dev` loads .env first and then .env.local; values here win. Put the Discord client ID and
# secret into .env.local too if you have no .env.

# Vite dev server; add <PUBLIC_URL>/auth/discord/callback as a redirect URI to your Discord application
PUBLIC_URL=http://localhost:5173
DISCORD_CLIENT_ID=change-me-discord-client-id
DISCORD_CLIENT_SECRET=change-me-discord-client-secret
# Your Discord user ID, so you can log in without an invite
OWNER_DISCORD_IDS=change-me-your-discord-user-id
# At least 32 characters; any value works locally
SESSION_SECRET=local-development-session-secret-0123456789
# No proxy in development
TRUST_PROXY=
# Plain HTTP on localhost
COOKIE_SECURE=false
LOG_LEVEL=debug

# Defaults, relative to the repository: the local database and the dataset built into data/<game-version>/
DB_PATH=./data-local/app.db
DATASET_DIR=./data
